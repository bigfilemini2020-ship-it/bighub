{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigHub",
  "version": "0.1.36",
  "identifier": "com.bigfile.bighub",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "https://bighub-tau.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BigHub",
        "url": "index.html",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ko-KR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMTc3MEQzM0IwMEYwOEYKUldTUDhBQTcwM0FYazVtNE05TkpLRGc0MWM1eFJNRVN5RmgwQkN0MVNOZkFiUmZPckxqVFQvckcK",
      "endpoints": [
        "https://github.com/bigfilemini2020-ship-it/bighub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
