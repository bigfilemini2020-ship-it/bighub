{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigHub",
  "version": "0.1.0",
  "identifier": "com.bigfile.bighub",
  "build": {
    "frontendDist": "../desktop-dist",
    "devUrl": "https://bighub-tau.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BigHub",
        "url": "https://bighub-tau.vercel.app",
        "width": 1280,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "ko-KR"
      }
    }
  }
}
